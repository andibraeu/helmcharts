{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/charts/.+/Chart\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/charts/music-assistant-server/Chart\\.yaml$/"],
      "matchStrings": ["appVersion:\\s*['\"]?(?<currentValue>[^'\"]+)['\"]?"],
      "depNameTemplate": "music-assistant/server",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/charts/stalwart/Chart\\.yaml$/"],
      "matchStrings": ["appVersion:\\s*['\"]?(?<currentValue>[^'\"]+)['\"]?"],
      "depNameTemplate": "stalwartlabs/stalwart",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/charts/spliit/Chart\\.yaml$/"],
      "matchStrings": ["appVersion:\\s*['\"]?(?<currentValue>[^'\"]+)['\"]?"],
      "depNameTemplate": "ghcr.io/spliit-app/spliit",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/charts/opencloud/Chart\\.yaml$/"],
      "matchStrings": ["appVersion:\\s*['\"]?(?<currentValue>[^'\"]+)['\"]?"],
      "depNameTemplate": "opencloudeu/opencloud-rolling",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["charts/ohcloud/**"],
      "enabled": false
    },
    {
      "matchFileNames": [
        "charts/music-assistant-server/Chart.yaml",
        "charts/stalwart/Chart.yaml",
        "charts/spliit/Chart.yaml",
        "charts/opencloud/Chart.yaml"
      ],
      "bumpVersions": [
        {
          "filePatterns": ["{{packageFileDir}}/Chart.yaml"],
          "matchStrings": ["version:\\s+\"?(?<version>\\d+\\.\\d+\\.\\d+)\"?"],
          "bumpType": "patch"
        }
      ]
    }
  ]
}
