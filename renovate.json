{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/charts/.+/Chart\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/charts/.+/Chart\\.yaml$/"],
      "matchStrings": ["appVersion:\\s*['\"]?(?<currentValue>[^'\"]+)['\"]?"],
      "depNameTemplate": "music-assistant/server",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "charts/music-assistant-server/Chart.yaml"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "additionalBranchPrefix": "chart-bump-",
      "bumpVersion": "patch"
    }
  ]
}
